rules_version = '2';
// Каждая семья видит только свои данные. Роли: parent — всё; child — только свои записи.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(fid) { return /databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid); }
    function isMember(fid) { return signedIn() && exists(memberPath(fid)); }
    function member(fid) { return get(memberPath(fid)).data; }
    function isParent(fid) { return isMember(fid) && member(fid).role == 'parent'; }
    function isChild(fid) { return isMember(fid) && member(fid).role == 'child'; }
    function invite(code) { return get(/databases/$(database)/documents/invites/$(code)).data; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid && isParent(request.resource.data.fid);
      allow delete: if signedIn() && isParent(resource.data.fid);
      // Код одноразовый: вошедший отмечает его использованным в той же операции, что и вступление в семью.
      allow update: if signedIn() && !('usedBy' in resource.data)
        && resource.data.exp > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/families/$(resource.data.fid)/members/$(request.auth.uid));
    }

    // Администраторы поддержки (назначает сервер-скрипт по свойству ADMIN_UID).
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Запросы в поддержку — переписка внутри приложения. Создаёт только родитель семьи от своего имени,
    // читают автор и администраторы. Адрес поддержки хранится в свойствах скрипта и никому не виден.
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function threadOk(who) { return !('thread' in changed())
      || (request.resource.data.thread.size() == resource.data.thread.size() + 1 && lastMsg().from == who && lastMsg().text is string && lastMsg().text.size() <= 4000); }
    function lastMsg() { return request.resource.data.thread[request.resource.data.thread.size() - 1]; }
    match /support/{id} {
      allow create: if signedIn()
        && id.matches('[A-Za-z0-9_-]{1,64}') && request.resource.data.id == id
        && request.resource.data.uid == request.auth.uid
        && isParent(request.resource.data.fid)
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 120
        && request.resource.data.thread is list && request.resource.data.thread.size() == 1
        && lastMsg().from == 'user' && lastMsg().text is string && lastMsg().text.size() > 0 && lastMsg().text.size() <= 4000
        && !('mailedAt' in request.resource.data) && !('notifiedAt' in request.resource.data);
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // Удаление: администратор — всегда; автор — когда администратор тоже удалил запрос у себя.
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.get('adminDeleted', false) == true);
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid
          && changed().hasOnly(['thread', 'status', 'userSeenAt', 'updatedAt', 'userDeleted', 'adminDeleted'])
          && (!('adminDeleted' in changed()) || request.resource.data.adminDeleted == false)
          && threadOk('user'))
        || (isAdmin()
          && changed().hasOnly(['thread', 'status', 'adminSeenAt', 'updatedAt', 'adminDeleted', 'userDeleted'])
          && (!('userDeleted' in changed()) || request.resource.data.userDeleted == false)
          && threadOk('support')));
    }

    match /families/{fid} {
      allow read: if isMember(fid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isParent(fid);

      match /members/{uid} {
        allow read: if isMember(fid);
        allow create: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/families/$(fid)) && (
          (get(/databases/$(database)/documents/families/$(fid)).data.createdBy == request.auth.uid
            && request.resource.data.role == 'parent')
          || (request.resource.data.code is string
            && invite(request.resource.data.code).fid == fid
            && invite(request.resource.data.code).role == request.resource.data.role
            && invite(request.resource.data.code).kidId == request.resource.data.kidId
            && invite(request.resource.data.code).exp > request.time.toMillis()
            && !('usedBy' in invite(request.resource.data.code))
            && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.get('usedBy', '') == request.auth.uid)
        );
        allow update: if isParent(fid)
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens', 'seen', 'name', 'photo', 'avatar', 'lang']));
        allow delete: if isParent(fid) || (signedIn() && request.auth.uid == uid);
      }

      // Что сделал ребёнок: задания, заявки на награды, игровое время.
      match /kidlog/{docId} {
        allow read: if isMember(fid);
        allow write: if isParent(fid);
        // Ребёнок только добавляет и дополняет свои записи; удалить месяц целиком не может.
        // Проверенные записи защищены снимком в решении родителя (plog), поэтому правка их здесь ни на что не влияет.
        allow create, update: if isChild(fid)
          && docId.matches(member(fid).kidId + '_[0-9]{4}-[0-9]{2}')
          && request.resource.data.kid == member(fid).kidId;
      }
      // Решения проверки, подарки и бонусы — пишут только родители.
      match /plog/{docId} {
        allow read: if isMember(fid);
        allow write: if isParent(fid);
      }
      // Фото-отчёты (сжатые), удаляются по сроку из настроек семьи (по умолчанию 14 дней).
      match /photos/{pid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && request.resource.data.data is string && request.resource.data.data.size() < 900000;
        allow delete: if isParent(fid);
      }
      // Служебные отметки сервер-скрипта (напоминания уже отправлены).
      match /sent/{day} {
        allow read, delete: if isParent(fid);
        allow create, update: if false;
      }
    }
  }
}
